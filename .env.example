# Pizza Promo Pro development overrides
# Milestone one uses mock providers only and requires no external credentials.

# Log level: debug, info, warn, or error
PIZZA_SOCIAL_HUB_LOG_LEVEL=info

# Explicitly keep providers in mock mode during milestone one.
PIZZA_SOCIAL_HUB_MEDIA_PROVIDER=mock
PIZZA_SOCIAL_HUB_SOCIAL_PUBLISHER=mock

# Never add API keys, OAuth tokens, signing certificates, or production secrets here.
